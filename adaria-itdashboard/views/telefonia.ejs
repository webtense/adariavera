  <script>
  (function(){
    var BASE={1:{101:1,102:0,103:1,104:1,105:1,106:0,107:1,108:1,109:1,110:1,111:1,112:0,114:1,115:0,116:1,117:1,118:0,119:1,120:1,121:0,122:0,123:1,124:0,125:1,126:1},
      2:{},3:{301:1,302:1,303:0,304:0,305:1,306:0,307:0,308:0,309:1,310:1,311:1,312:1,314:1,315:0,316:1,317:1,318:1,319:1,320:1,321:1,322:1,323:1,324:1,325:1,326:1}};
    for(var n=201;n<=226;n++){ if(n!==213) BASE[2][n]=0; }
    var KEY="adaria-tel-dash-v1";
    function clone(o){return JSON.parse(JSON.stringify(o));}
    var state; try{ state=JSON.parse(localStorage.getItem(KEY))||clone(BASE);}catch(e){ state=clone(BASE);}
    function save(){ try{localStorage.setItem(KEY,JSON.stringify(state));}catch(e){} }
    var solo=false;
    var floorsEl=document.getElementById("habFloors");
    function render(){
      floorsEl.innerHTML=""; var tOk=0,tNo=0;
      [1,2,3].forEach(function(f){
        var rooms=state[f]; var nums=Object.keys(rooms).map(Number).sort(function(a,b){return a-b;});
        var ok=0; nums.forEach(function(n){ if(rooms[n])ok++; }); var tot=nums.length; tOk+=ok; tNo+=(tot-ok);
        var pct=tot?Math.round(ok/tot*100):0;
        var sec=document.createElement("div"); sec.className="habfloor";
        var head=document.createElement("div"); head.className="fh";
        head.innerHTML='<h3>Planta '+f+'</h3><div class="fbar"><i style="width:'+pct+'%"></i></div><span class="meta">'+ok+'/'+tot+' operativos</span>';
        sec.appendChild(head);
        var grid=document.createElement("div"); grid.className="habgrid";
        nums.forEach(function(n){
          var okv=!!rooms[n]; if(solo&&okv) return;
          var b=document.createElement("button"); b.type="button"; b.className="habr "+(okv?"ok":"no");
          b.setAttribute("aria-pressed",okv?"true":"false");
          b.setAttribute("aria-label","Habitación "+n+", "+(okv?"funciona":"no funciona")+", tocar para cambiar");
          b.innerHTML='<div class="n">'+n+'</div><div class="s">'+(okv?"OK":"NO")+'</div>';
          b.addEventListener("click",function(){ state[f][n]=okv?0:1; save(); render(); });
          grid.appendChild(b);
        });
        if(!grid.children.length){ var p=document.createElement("div"); p.style.cssText="color:#5b6c74;font-size:13px"; p.textContent="Sin averías en esta planta."; grid.appendChild(p); }
        sec.appendChild(grid); floorsEl.appendChild(sec);
      });
      var tot=tOk+tNo, pct=tot?Math.round(tOk/tot*100):0;
      document.getElementById("habOk").textContent=tOk;
      document.getElementById("habNo").textContent=tNo;
      document.getElementById("habTot").textContent=tot;
      document.getElementById("habPct").textContent=pct+"%";
      document.getElementById("habBar").style.width=pct+"%";
    }
    document.getElementById("habSolo").addEventListener("click",function(){ solo=!solo; this.setAttribute("aria-pressed",solo?"true":"false"); render(); });
    document.getElementById("habReset").addEventListener("click",function(){ state=clone(BASE); save(); solo=false; document.getElementById("habSolo").setAttribute("aria-pressed","false"); render(); });
    render();
  })();
  </script>


