const erApp=document.getElementById('erApp');
let ER=erLoad()||JSON.parse(JSON.stringify(ER_DATA0));
function erEsc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function erRender(){erApp.innerHTML='';for(const k in ER){const[cls,title]=k.split('|');const g=document.createElement('div');g.className='er-group '+cls;const rows=ER[k].map((r,ri)=>'<tr>'+r.map((c,ci)=>'<td contenteditable oninput="erEdit(\''+k+'\','+ri+','+ci+',this)">'+erEsc(c)+'</td>').join('')+'<td class="er-del" onclick="erDel(\''+k+'\','+ri+')">✕</td></tr>').join('');g.innerHTML='<h2>'+title+'</h2><table><thead><tr>'+ER_COLS.map(c=>'<th>'+c+'</th>').join('')+'<th></th></tr></thead><tbody>'+rows+'</tbody></table><button class="er-add" onclick="erAdd(\''+k+'\')">+ añadir fila</button>';erApp.appendChild(g);}}
function erEdit(k,ri,ci,el){ER[k][ri][ci]=el.innerText;erSave(true)}
function erAdd(k){ER[k].push(["","","","","",""]);erRender();erSave(true)}
function erDel(k,ri){if(confirm('¿Borrar fila?')){ER[k].splice(ri,1);erRender();erSave(true)}}
function erSave(s){localStorage.setItem('estred_vera',JSON.stringify(ER));const e=document.getElementById('erStatus');e.textContent='Guardado '+new Date().toLocaleTimeString('es-ES')}
function erLoad(){try{return JSON.parse(localStorage.getItem('estred_vera'))}catch(e){return null}}
function erReset(){if(confirm('¿Restaurar original? Perderás tus ediciones.')){ER=JSON.parse(JSON.stringify(ER_DATA0));erRender();erSave()}}
function erExport(){const b=new Blob([JSON.stringify(ER,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='estructura_red_vera.json';a.click()}
function erImport(ev){const f=ev.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{ER=JSON.parse(r.result);erRender();erSave()}catch(x){alert('JSON no válido')}};r.readAsText(f)}
erRender();
</script>
