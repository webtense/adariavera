<%- include('partials/header', { title: 'Auditoría — Adaria Vera' }) %>
<h1>Auditoría de accesos</h1>
<p class="sub">Quién entra, quién falla al entrar y quién consulta cada contraseña. Últimos 500 eventos.</p>

<form method="get" action="/auditoria" style="margin-bottom:16px">
  <div class="row" style="align-items:flex-end">
    <div style="max-width:280px"><label>Filtrar por acción</label>
      <select name="accion" onchange="this.form.submit()">
        <option value="">— todas —</option>
        <% acciones.forEach(function(a){ %><option value="<%= a %>" <%= filtro===a?'selected':'' %>><%= a %></option><% }) %>
      </select></div>
  </div>
</form>

<div class="table-wrap"><table>
  <thead><tr><th style="width:160px">Fecha/hora</th><th>Usuario</th><th>Acción</th><th>Detalle</th><th>IP</th></tr></thead>
  <tbody>
  <% rows.forEach(function(r){ %>
    <tr>
      <td class="mono muted"><%= r.ts %></td>
      <td class="mono"><%= r.username || '—' %></td>
      <td><span class="badge <%= r.accion==='LOGIN_FAIL'?'b-off':(r.accion==='VER_PASSWORD'?'b-lector':'b-ok') %>"><%= r.accion %></span></td>
      <td><%= r.detalle || '' %></td>
      <td class="mono muted"><%= r.ip || '' %></td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<% if(!rows.length){ %><p class="muted">Sin eventos.</p><% } %>
<%- include('partials/footer') %>
