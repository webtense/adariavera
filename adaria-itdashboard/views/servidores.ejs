<%- include('partials/header', { title: 'Servidores — Adaria Vera' }) %>
<h1>Servidores</h1>
<p class="sub">Infraestructura de servidores del hotel. Contraseñas con botón «Ver» (auditado).</p>
<% if(user&&user.role==='admin'){ %><p><a class="btn btn-sm" href="/editar/servers">✏️ Editar datos</a></p><% } %>
<div class="table-wrap"><table>
  <thead><tr><th>Servidor</th><th>Rol</th><th>IP</th><th>SO</th><th>Usuario</th><th>Contraseña</th><th>Notas</th></tr></thead>
  <tbody>
  <% servers.forEach(function(s){ %>
    <tr>
      <td><strong><%= s.nombre %></strong></td>
      <td><%= s.rol||'' %></td>
      <td class="mono"><%= s.ip||'—' %></td>
      <td><%= s.so||'' %></td>
      <td class="mono"><%= s.usuario||'—' %></td>
      <td><span class="pw" id="pw-<%= s.id %>">••••••••</span>
        <button class="btn btn-sm btn-out reveal" data-t="servers" data-id="<%= s.id %>" type="button">👁 Ver</button></td>
      <td class="muted"><%= s.notas||'' %></td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<%- include('partials/reveal_script') %>
<%- include('partials/footer') %>
