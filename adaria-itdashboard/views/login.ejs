<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acceso · Dashboard IT Adaria Vera</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <div class="login-bg">
    <form class="login-card" method="post" action="/login" autocomplete="off">
      <div class="logo">🌊</div>
      <h1>Dashboard IT<br>Hotel Adaria Vera</h1>
      <p class="muted" style="text-align:center">Acceso restringido y auditado</p>
      <% if (error){ %><div class="alert alert-err"><%= error %></div><% } %>
      <label for="username">Usuario</label>
      <input id="username" name="username" autofocus required>
      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" required>
      <button class="btn" type="submit" style="width:100%;margin-top:18px">Entrar</button>
    </form>
  </div>
</body>
</html>
